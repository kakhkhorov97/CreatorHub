{
  "name": "creatorhub-backend",
  "version": "0.0.1",
  "description": "CreatorHub portfolio discovery and private inquiry backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:batch": "nest start Creator-batch --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/apps/Creator-api/main",
    "start:prod:batch": "node dist/apps/Creator-batch/main",
    "lint": "eslint \"apps/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --runInBand --testPathPattern=creatorhub.integration",
    "format:check": "prettier --check \"apps/**/*.ts\"",
    "lint:fix": "eslint \"apps/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p apps/Creator-api/tsconfig.app.json",
    "test:integration": "jest --runInBand --testPathPattern=creatorhub.integration",
    "build:batch": "nest build Creator-batch",
    "db:setup": "ts-node apps/Creator-api/src/database/setup.ts",
    "db:admin": "ts-node apps/Creator-api/src/database/admin.ts",
    "schema:export": "ts-node apps/Creator-api/src/schema.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.9.5",
    "@nestjs/apollo": "^12.0.10",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.0.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "graphql": "^16.8.1",
    "libphonenumber-js": "^1.13.10",
    "mongoose": "^8.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "bcryptjs": "^2.4.3",
    "@nestjs/schedule": "^4.0.0",
    "graphql-upload": "^13.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "@types/bcryptjs": "^2.4.6"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "CommonJS",
            "moduleResolution": "node",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/Creator-api/src/**/*.ts",
      "!**/main.ts",
      "!**/database/setup.ts",
      "!**/database/admin.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "/node_modules/(?!uuid/)"
    ]
  }
}
