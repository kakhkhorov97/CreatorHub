{
	"name": "creatorhub-backend",
	"version": "0.0.1",
	"description": "CreatorHub portfolio discovery and private inquiry backend",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"postbuild": "node scripts/package-demo-media.cjs",
		"format": "prettier --write \"apps/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:dev:batch": "nest start Creator-batch --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "NODE_ENV=production node dist/apps/Creator-api/main",
		"start:prod:batch": "node dist/apps/Creator-batch/main",
		"lint": "eslint \"apps/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --runInBand --testPathPatterns=creatorhub.integration",
		"format:check": "prettier --check \"apps/**/*.ts\"",
		"lint:fix": "eslint \"apps/**/*.ts\" --fix",
		"typecheck": "tsc --noEmit -p apps/Creator-api/tsconfig.app.json",
		"test:integration": "jest --runInBand --testPathPatterns=creatorhub.integration",
		"build:batch": "nest build Creator-batch",
		"db:setup": "ts-node apps/Creator-api/src/database/setup.ts",
		"db:admin": "ts-node apps/Creator-api/src/database/admin.ts",
		"schema:export": "ts-node apps/Creator-api/src/schema.ts"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@nestjs/apollo": "^13.4.5",
		"@nestjs/common": "^11.2.7",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.7",
		"@nestjs/graphql": "^13.4.5",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mongoose": "^11.0.4",
		"@nestjs/platform-express": "^11.2.7",
		"@nestjs/platform-socket.io": "^11.2.7",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/websockets": "^11.2.7",
		"bcryptjs": "^2.4.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.0",
		"graphql": "^16.14.2",
		"graphql-upload": "^15.0.2",
		"libphonenumber-js": "^1.13.10",
		"mongoose": "^8.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.4",
		"uuid": "^14.0.2",
		"@as-integrations/express5": "^1.1.2",
		"express": "^5.2.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.7",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.3.1",
		"@types/supertest": "^2.0.12",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"jest": "^30.5.2",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-jest": "^29.4.14",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"webpack": "^5.111.1"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.ts$": "ts-jest",
			"^.+\\.js$": [
				"ts-jest",
				{
					"tsconfig": {
						"allowJs": true,
						"module": "CommonJS",
						"moduleResolution": "node",
						"resolvePackageJsonExports": false
					}
				}
			]
		},
		"collectCoverageFrom": [
			"apps/Creator-api/src/**/*.ts",
			"!**/main.ts",
			"!**/database/setup.ts",
			"!**/database/admin.ts"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/apps/"
		],
		"testTimeout": 30000,
		"transformIgnorePatterns": [
			"/node_modules/(?!uuid/)"
		]
	},
	"overrides": {
		"qs": "^6.16.0",
		"lodash": "^4.18.1",
		"ws@^8.0.0": "^8.22.0",
		"body-parser@^1.0.0": "^1.20.8",
		"@graphql-tools/utils": "^12.0.1",
		"@graphql-tools/merge": "^9.2.4",
		"@graphql-tools/schema": "^10.1.1",
		"minimatch@^9.0.0": "^9.0.7",
		"js-yaml@^3.13.1": "^4.3.2"
	},
	"engines": {
		"node": ">=22.22.1 <23"
	}
}
