NODE_ENV=development
PORT_API=3001
PORT_BATCH=3002
# Use a separate CreatorHub database. A replica set is required for transactions.
MONGO_DEV=mongodb://127.0.0.1:27017/creatorhub?replicaSet=rs0
MONGO_PROD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_TOKEN=
FRONTEND_URL=http://localhost:3000
# Files live under MEDIA_BASE_URL/<userId>/<filename>.
MEDIA_BASE_URL=https://media.example.com/creatorhub
# Optional in development: without this, emails are written to .local/mail.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Optional AI-to-filter adapter. Without it discovery is explicitly labeled KEYWORD.
DISCOVERY_PARSER_URL=
DISCOVERY_PARSER_TOKEN=

# Social providers are optional until their app IDs and frontend authorization flow are configured.
GOOGLE_CLIENT_ID=
# Telegram OIDC bot/application client ID.
TELEGRAM_CLIENT_ID=
# Kakao REST API app key with OpenID Connect enabled.
KAKAO_CLIENT_ID=
